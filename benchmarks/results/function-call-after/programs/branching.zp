start:
    let iterations: number = 50000 // BENCH_ITERATIONS
    let expected: number = 3124925000 // BENCH_EXPECTED
    let checksum: number = 0

    for (let i: number = 0; i < iterations; i++):
        if i % 2 == 0:
            checksum += i * 3 + 1
        else:
            checksum += i * 2 - 1
        end
    end

    if checksum == expected:
        say("CHECKSUM branching 3124925000")
    else:
        say("CHECKSUM_ERROR branching")
    end
stop
