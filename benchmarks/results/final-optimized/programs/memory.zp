use zmemory.management

start {
    let iterations: number = 10000 // BENCH_ITERATIONS
    let expected: number = 69995 // BENCH_EXPECTED
    let checksum: number = 0

    for (let i: number = 0; i < iterations; i++) {
        let transient: number[] = [i, i % 11 + 2, i + 1]
        checksum += transient[1]
    } end for

    if checksum == expected {
        say("CHECKSUM memory 69995")
    } else {
        say("CHECKSUM_ERROR memory")
    } end if
} stop
