    return __zhttp_requestHeader(requestJson, name)
} end fn

pub fn request(method: string, url: string, headersJson: string, body: string, timeoutMilliseconds: number): string {
    return __zhttp_clientRequest(method, url, headersJson, body, timeoutMilliseconds)
