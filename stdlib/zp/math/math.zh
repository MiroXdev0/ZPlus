start {
pub fn pi(): number {
    return __zstdlib_math_pi()
} end fn
pub fn e(): number {
    return __zstdlib_math_e()
} end fn

pub fn sqrt(value: number): number {
    return __zstdlib_math_sqrt(value)
} end fn
pub fn pow(base: number, exponent: number): number {
    return __zstdlib_math_pow(base, exponent)
} end fn
pub fn abs(value: number): number {
    return __zstdlib_math_abs(value)
} end fn
pub fn min(left: number, right: number): number {
    return __zstdlib_math_min(left, right)
} end fn
pub fn max(left: number, right: number): number {
    return __zstdlib_math_max(left, right)
} end fn
pub fn round(value: number): number {
    return __zstdlib_math_round(value)
} end fn
pub fn floor(value: number): number {
    return __zstdlib_math_floor(value)
} end fn
pub fn ceil(value: number): number {
    return __zstdlib_math_ceil(value)
} end fn
pub fn sin(value: number): number {
    return __zstdlib_math_sin(value)
} end fn
pub fn cos(value: number): number {
    return __zstdlib_math_cos(value)
} end fn
pub fn tan(value: number): number {
    return __zstdlib_math_tan(value)
} end fn
pub fn asin(value: number): number {
    return __zstdlib_math_asin(value)
} end fn
pub fn acos(value: number): number {
    return __zstdlib_math_acos(value)
} end fn
pub fn atan(value: number): number {
    return __zstdlib_math_atan(value)
} end fn
pub fn log(value: number): number {
    return __zstdlib_math_log(value)
} end fn
pub fn log10(value: number): number {
    return __zstdlib_math_log10(value)
} end fn
pub fn exp(value: number): number {
    return __zstdlib_math_exp(value)
} end fn
} stop
