pub fn get(name: string): string {
    return __zstdlib_env_get(name)
} end fn
pub fn set(name: string, value: string) {
    __zstdlib_env_set(name, value)
} end fn
pub fn exists(name: string): boolean {
    return __zstdlib_env_exists(name)
} end fn
pub fn homeDirectory(): string {
    return __zstdlib_env_homeDirectory()
} end fn
pub fn currentDirectory(): string {
    return __zstdlib_env_currentDirectory()
} end fn
pub fn arguments(): string[] {
    return __zstdlib_args_all()
} end fn
