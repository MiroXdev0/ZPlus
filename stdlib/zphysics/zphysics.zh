end

pub fn setLinearDamping(body: number, damping: number):
    __zphysics_setLinearDamping(body, damping)
end

pub fn setAngularDamping(body: number, damping: number):
    __zphysics_setAngularDamping(body, damping)
end

pub fn applyForce(body: number, x: number, y: number):
    __zphysics_applyForce(body, x, y)
end

pub fn applyImpulse(body: number, x: number, y: number):
    __zphysics_applyImpulse(body, x, y)
end

pub fn applyTorque(body: number, torque: number):
    __zphysics_applyTorque(body, torque)
end

pub fn createCircle(world: number, body: number, radius: number) -> number:
    return __zphysics_createCircle(world, body, radius)
end

pub fn createBox(world: number, body: number, width: number, height: number) -> number:
    return __zphysics_createBox(world, body, width, height)
end

pub fn createPolygon(world: number, body: number, vertices: string) -> number:
    return __zphysics_createPolygon(world, body, vertices)
