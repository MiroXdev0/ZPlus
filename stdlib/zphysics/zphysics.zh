pub fn createWorld(gravityX: number, gravityY: number) -> number:
    return __zphysics_createWorld(gravityX, gravityY)
end

pub fn destroyWorld(world: number):
    __zphysics_destroyWorld(world)
end

pub fn setGravity(world: number, x: number, y: number):
    __zphysics_setGravity(world, x, y)
end

pub fn getGravityX(world: number) -> number:
    return __zphysics_getGravityX(world)
end

pub fn getGravityY(world: number) -> number:
    return __zphysics_getGravityY(world)
end

pub fn setFixedTimeStep(world: number, seconds: number):
    __zphysics_setFixedTimeStep(world, seconds)
end

pub fn setIterations(world: number, count: number):
    __zphysics_setIterations(world, count)
end

pub fn setPaused(world: number, paused: boolean):
    __zphysics_setPaused(world, paused)
end

pub fn isPaused(world: number) -> boolean:
    return __zphysics_isPaused(world)
end

pub fn update(world: number, deltaTime: number):
    __zphysics_update(world, deltaTime)
end

pub fn bodyCount(world: number) -> number:
    return __zphysics_bodyCount(world)
end

pub fn shapeCount(world: number) -> number:
    return __zphysics_shapeCount(world)
end

pub fn contactCount(world: number) -> number:
    return __zphysics_contactCount(world)
end

pub fn createBody(world: number, bodyType: string, x: number, y: number) -> number:
    return __zphysics_createBody(world, bodyType, x, y)
end

pub fn destroyBody(body: number):
    __zphysics_destroyBody(body)
end

pub fn setPosition(body: number, x: number, y: number):
    __zphysics_setPosition(body, x, y)
end

pub fn getPositionX(body: number) -> number:
