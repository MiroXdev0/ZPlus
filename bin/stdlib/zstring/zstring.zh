start {
pub fn upper(value: string): string {
    return __zstdlib_string_upper(value)
} end fn
pub fn lower(value: string): string {
    return __zstdlib_string_lower(value)
} end fn
pub fn trim(value: string): string {
    return __zstdlib_string_trim(value)
} end fn
pub fn split(value: string, delimiter: string): string[] {
    return __zstdlib_string_split(value, delimiter)
} end fn
pub fn join(values: string[], separator: string): string {
    return __zstdlib_string_join(values, separator)
} end fn
pub fn replace(value: string, search: string, replacement: string): string {
    return __zstdlib_string_replace(value, search, replacement)
} end fn
pub fn contains(value: string, search: string): boolean {
    return __zstdlib_string_contains(value, search)
} end fn
pub fn startsWith(value: string, prefix: string): boolean {
    return __zstdlib_string_startsWith(value, prefix)
} end fn
pub fn endsWith(value: string, suffix: string): boolean {
    return __zstdlib_string_endsWith(value, suffix)
} end fn
pub fn substring(value: string, offset: number, size: number): string {
    return __zstdlib_string_substring(value, offset, size)
} end fn
pub fn length(value: string): number {
    return __zstdlib_string_length(value)
} end fn
pub fn reverse(value: string): string {
    return __zstdlib_string_reverse(value)
} end fn
pub fn repeat(value: string, repetitions: number): string {
    return __zstdlib_string_repeat(value, repetitions)
} end fn
} stop
