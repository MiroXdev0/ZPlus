use zp.graphics

start {

    let app = graphics.createWindow("Hello, Z+", 720, 420)
    graphics.background(app, "#18202B")
    graphics.text(app, "A real Z+ desktop window", 36, 44, "#FFFFFF", 30)
    graphics.text(app, "Close the window to exit.", 38, 104, "#B8C7D9", 18)
    graphics.show(app)
    graphics.run(app)
} stop
