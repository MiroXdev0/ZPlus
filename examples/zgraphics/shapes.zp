use zgraphics

start {

    let app = zgraphics.createWindow("Z+ Shapes", 760, 520)
    zgraphics.background(app, "#151923")
    zgraphics.text(app, "Drawing with ZGraphics", 28, 24, "#FFFFFF", 28)
    zgraphics.line(app, 40, 100, 700, 100, "#58677D", 3)
    zgraphics.rectangle(app, 50, 140, 180, 110, "#34D399", true, 2)
    zgraphics.rectangle(app, 270, 140, 180, 110, "#FBBF24", false, 5)
    zgraphics.circle(app, 570, 190, 60, "#60A5FA", true, 2)
    zgraphics.circle(app, 570, 360, 60, "#F472B6", false, 5)
    zgraphics.text(app, "Filled rectangle", 50, 275, "#D1D5DB", 16)
    zgraphics.text(app, "Outlined rectangle", 270, 275, "#D1D5DB", 16)
    zgraphics.text(app, "Filled circle", 505, 275, "#D1D5DB", 16)
    zgraphics.text(app, "Outlined circle", 505, 445, "#D1D5DB", 16)
    zgraphics.show(app)
    zgraphics.run(app)
} stop
