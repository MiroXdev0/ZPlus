use zp.graphics

start {

    let app = graphics.createWindow("Z+ Text Input", 640, 300)
    let value = ""
    graphics.background(app, "#151923")
    graphics.text(app, "Type into this window", 32, 30, "#FFFFFF", 26)
    graphics.rectangle(app, 32, 105, 560, 56, "#252D3A", true, 1)
    graphics.text(app, value, 44, 119, "#A7F3D0", 22)
    graphics.text(app, "Text events are delivered as UTF-8 strings.", 32, 205, "#B8C7D9", 16)
    graphics.show(app)

    while true {
        let event = graphics.waitEvent(app)
        if event == 1 {
            break
        } else {
        } end if
        if event == 6 {
            value += graphics.eventText(app)
            say(graphics.eventText(app))
            graphics.rectangle(app, 32, 105, 560, 56, "#252D3A", true, 1)
            graphics.text(app, value, 44, 119, "#A7F3D0", 22)
        } else {
        } end if
    } end while
} stop
