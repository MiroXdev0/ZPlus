start {
    let name = read(string("What is your name? "))
    let age = read_integer("How old are you? ")
    let value = read_number("Enter a decimal number: ")
    let answer = read_boolean("Are you a Z+ developer? (true/false) ")

    say("Hello, " + name)
    if age >= 0 {
        say("Age accepted.")
    } else {
        say("Age is negative.")
    } end if
    if value > 0 {
        say("The decimal value is positive.")
    } else {
        say("The decimal value is not positive.")
    } end if
    if answer {
        say("You answered true.")
    } else {
        say("You answered false.")
    } end if
} stop
