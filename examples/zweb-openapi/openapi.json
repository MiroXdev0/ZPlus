{
  "openapi": "3.1.0",
  "info": {
    "title": "Z+ Web Interoperability Example",
    "version": "1.0.0"
  },
  "paths": {
    "/api/greetings/{name}": {
      "parameters": [
        {
          "name": "name",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getGreeting",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": { "type": "string", "default": "en" }
          }
        ],
        "responses": {
          "200": {
            "description": "A greeting.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Greeting" }
              }
            }
          }
        }
      }
    },
    "/api/echo": {
      "post": {
        "operationId": "echo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EchoInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The submitted JSON value.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoInput" }
              }
            }
          },
          "400": { "description": "Invalid JSON request body." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Greeting": {
        "type": "object",
        "required": ["message", "locale"],
        "properties": {
          "message": { "type": "string" },
          "locale": { "type": "string" }
        },
        "additionalProperties": false
      },
      "EchoInput": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
