use zmath as math
use zstring as text
use zcollections as collections
use zrandom as random
use zfile as file
use zpath as path
use ztime as time
use zenv as env
use zargs as args
use zlog as log

start {
    fn options(){
        printz("1. Add task\n")
        printz("2. View tasks\n")
        printz("3. Delete task\n")
        printz("4. Exit\n")
    } end fn

    printz("Hello, wanna save some tasks? y/n\n")
    let choice = read()

    if choice == "y" {
        printz("Great! Let's save some tasks.\n")
    } else {
        printz("Okay, maybe next time.\n")
    } end if
    while true{
            say("Choose an option: ")
            options()
            let sjkdfgrgelkjshgkjehgekhjkjgnjkerghlamaldmsciehgfhjkh: string = read()
            switch sjkdfgrgelkjshgkjehgekhjkjgnjkerghlamaldmsciehgfhjkh {
                case "1" {
                    printz("Adding task...\n")
                    addtask()
                }
                case "2" {
                    printz("Viewing tasks...\n")
                    viewtasks()
                }
                case "3" {
                    printz("Deleting task...\n")
                    deletetask()
                }
                case "4" {
                    printz("Exiting...\n")
                    break
                }
                default {
                    printz("Invalid option.\n")
                }
            } end switch
    } end while
    fn addtask(){
        say("Enter task your task: ")
        let newtask: string = read()
        try{
            file.write("tasks.txt", newtask)
        }catch error{
            say("Error: " + error.message)
        } end try
    } end fn
    fn viewtasks(){
        try{
            let tasks: string = file.read("tasks.txt")
            for (let i = 0; i < tasks.length; i++) {
                say(tasks[i] + "\n")
            } end for
        }catch error{
            say("Error: " + error.message)
        } end try
    } end fn
    fn deletetask(){
        try{
            file.delete("tasks.txt")
        }catch error{
            say("Error: " + error.message)
        } end try
    } end fn
} stop