use zp.graphics
use "window.zh" as app_window
use "ui/layout.zh" as layout

start {

    let app = app_window.create("{{PROJECT_NAME}}")
    let clicks = 0
    graphics.show(app)
    while graphics.isOpen(app) {
        graphics.update(app)
        if graphics.keyPressed(app, 27) {
            graphics.close(app)
        } else {
        } end if
        if graphics.isOpen(app) {
            if graphics.mouseButtonPressed(app, 1) {
                clicks += 1
            } else {
            } end if
            graphics.clear(app)
            app_window.drawFrame(app, clicks)
        } else {
        } end if
    } end while
} stop
