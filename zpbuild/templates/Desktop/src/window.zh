use zp.graphics
use "ui/layout.zh" as layout
start {

pub fn create(title: string): number {
    let window = graphics.createWindow(title, 720, 440)
    graphics.background(window, "#111827")
    graphics.setTargetFPS(window, 60)
    return window
} end fn

pub fn drawFrame(window: number, clicks: number) {
    layout.draw(window, clicks)
} end fn
} stop
