use zp.graphics
start {

pub fn draw(window: number, clicks: number) {
    graphics.rectangle(window, 0, 0, 720, 440, "#111827", true, 1)
    graphics.text(window, "Z+ Desktop Starter", 36, 34, "#F8FAFC", 30)
    graphics.text(window, "Text is drawn with the public ZGraphics API.", 38, 84, "#CBD5E1", 18)
    graphics.rectangle(window, 38, 142, 240, 72, "#2563EB", true, 1)
    graphics.text(window, "Click anywhere", 58, 158, "#FFFFFF", 20)
    graphics.text(window, "Clicks: " + graphics.numberText(clicks), 38, 252, "#A7F3D0", 22)
    graphics.text(window, "Click to increment; press Escape to quit.", 38, 380, "#94A3B8", 16)
} end fn
} stop
