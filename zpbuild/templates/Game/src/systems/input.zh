use zp.graphics
start {

pub fn horizontal(window: number): number {
    if graphics.keyDown(window, 65) or graphics.keyDown(window, 97) {
        return -1
    } else {
    } end if
    if graphics.keyDown(window, 68) or graphics.keyDown(window, 100) {
        return 1
    } else {
    } end if
    return 0
} end fn

pub fn vertical(window: number): number {
    if graphics.keyDown(window, 87) or graphics.keyDown(window, 119) {
        return -1
    } else {
    } end if
    if graphics.keyDown(window, 83) or graphics.keyDown(window, 115) {
        return 1
    } else {
    } end if
    return 0
} end fn
} stop
