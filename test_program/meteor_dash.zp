1use zgraphics
use zmath as math

start:
    let app = zgraphics.createWindow("Geometry Dash", 640, 480)
    zgraphics.background(app, "#0B1020")
    zgraphics.setTargetFPS(app, 60)
    zgraphics.show(app)

    let playerX = 300
    let playerY = 420
    let meteor1X = 100
    let meteor1Y = -40
    let meteor2X = 300
    let meteor2Y = -180
    let meteor3X = 500
    let meteor3Y = -320
    let score = 0
    let gameOver = false
    let frameTime = 0

    while zgraphics.isOpen(app):
        zgraphics.update(app)
        if zgraphics.keyDown(app, 27):
            zgraphics.close(app)
        else:
        end

        if zgraphics.isOpen(app):
            frameTime = zgraphics.deltaTimeMs(app)
            if frameTime > 50:
                frameTime = 50
            else:
            end

            if gameOver:
                if zgraphics.keyPressed(app, 32):
                    playerX = 300
                    meteor1X = 100
                    meteor1Y = -40
                    meteor2X = 300
                    meteor2Y = -180
                    meteor3X = 500
                    meteor3Y = -320
                    score = 0
                    gameOver = false
                else:
                end
            else:
                if zgraphics.keyDown(app, 65) or zgraphics.keyDown(app, 97) or zgraphics.keyDown(app, 37) or zgraphics.keyDown(app, 65361):
                    playerX -= 360 * frameTime / 1000
                else:
                end
                if zgraphics.keyDown(app, 68) or zgraphics.keyDown(app, 100) or zgraphics.keyDown(app, 39) or zgraphics.keyDown(app, 65363):
                    playerX += 360 * frameTime / 1000
                else:
                end
                if playerX < 0:
                    playerX = 0
                else:
                end
                if playerX > 600:
                    playerX = 600
                else:
                end

                meteor1Y += 190 * frameTime / 1000
                meteor2Y += 240 * frameTime / 1000
                meteor3Y += 290 * frameTime / 1000

                if meteor1Y > 500:
                    meteor1Y = -40
                    if meteor1X == 100:
                        meteor1X = 300
                    else:
                        if meteor1X == 300:
                            meteor1X = 500
                        else:
                            meteor1X = 100
                        end
                    end
                    score += 1
                else:
                end
                if meteor2Y > 500:
                    meteor2Y = -100
                    if meteor2X == 100:
                        meteor2X = 300
                    else:
                        if meteor2X == 300:
                            meteor2X = 500
                        else:
                            meteor2X = 100
                        end
                    end
                    score += 1
                else:
                end
                if meteor3Y > 500:
                    meteor3Y = -220
                    if meteor3X == 100:
                        meteor3X = 300
                    else:
                        if meteor3X == 300:
                            meteor3X = 500
                        else:
                            meteor3X = 100
                        end
                    end
                    score += 1
                else:
                end

                if zgraphics.rectanglesIntersect(math.floor(playerX), playerY, 40, 24, meteor1X, math.floor(meteor1Y), 40, 28):
                    gameOver = true
                else:
                end
                if zgraphics.rectanglesIntersect(math.floor(playerX), playerY, 40, 24, meteor2X, math.floor(meteor2Y), 40, 28):
                    gameOver = true
                else:
                end
                if zgraphics.rectanglesIntersect(math.floor(playerX), playerY, 40, 24, meteor3X, math.floor(meteor3Y), 40, 28):
                    gameOver = true
                else:
                end
            end

            zgraphics.clear(app)
            zgraphics.text(app, "GEOMETRY DASH", 24, 22, "#E2E8F0", 24)
            zgraphics.text(app, "A / D or arrow keys: move", 24, 50, "#94A3B8", 14)
            zgraphics.text(app, "Score: " + zgraphics.numberText(score), 500, 28, "#FDE68A", 18)
            zgraphics.rectangle(app, 20, 78, 600, 2, "#334155", true, 1)

            zgraphics.circle(app, 70, 130, 2, "#64748B", true, 1)
            zgraphics.circle(app, 240, 180, 2, "#64748B", true, 1)
            zgraphics.circle(app, 410, 120, 2, "#64748B", true, 1)
            zgraphics.circle(app, 570, 220, 2, "#64748B", true, 1)
            zgraphics.circle(app, 150, 300, 2, "#64748B", true, 1)
            zgraphics.circle(app, 490, 350, 2, "#64748B", true, 1)

            zgraphics.rectangle(app, meteor1X, math.floor(meteor1Y), 40, 28, "#F97316", true, 1)
            zgraphics.rectangle(app, meteor2X, math.floor(meteor2Y), 40, 28, "#FB7185", true, 1)
            zgraphics.rectangle(app, meteor3X, math.floor(meteor3Y), 40, 28, "#A78BFA", true, 1)
            zgraphics.rectangle(app, math.floor(playerX), playerY, 40, 24, "#38BDF8", true, 1)
            zgraphics.rectangle(app, math.floor(playerX) + 14, playerY - 8, 12, 8, "#BAE6FD", true, 1)
            zgraphics.rectangle(app, 20, 456, 600, 2, "#334155", true, 1)

            if gameOver:
                zgraphics.rectangle(app, 120, 170, 400, 130, "#111827", true, 1)
                zgraphics.text(app, "CRASH!", 268, 202, "#FCA5A5", 32)
                zgraphics.text(app, "Final score: " + zgraphics.numberText(score), 225, 242, "#E2E8F0", 18)
                zgraphics.text(app, "Press SPACE to play again", 205, 274, "#94A3B8", 16)
            else:
            end
        else:
        end
    end
stop
