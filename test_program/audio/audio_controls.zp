use zaudio

let count = zaudio.deviceCount()
say("Playback devices:")
say(count)

if count > 0:
    let selected = zaudio.defaultDevice()
    say("Default playback device:")
    say(selected)
    zaudio.selectDevice(selected)
    zaudio.initialize()

    zaudio.setMasterVolume(0.8)
    say("Master volume:")
    say(zaudio.getMasterVolume())
    zaudio.mute()
    say("Muted:")
    say(zaudio.isMuted())
    zaudio.unmute()
    say("Muted after unmute:")
    say(zaudio.isMuted())

    zaudio.shutdown()
else:
    say("No playback device is available")
end
