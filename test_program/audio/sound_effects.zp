use zaudio

start {

zaudio.initialize()
let firstEffect = zaudio.loadSound("assets/tone.wav")
let secondEffect = zaudio.loadSound("assets/tone.mp3")

zaudio.setVolume(firstEffect, 0.8)
zaudio.setVolume(secondEffect, 0.5)
zaudio.play(firstEffect)
zaudio.play(secondEffect)
zaudio.play(firstEffect)

say("Two independent sound effects are playing")
zaudio.stop(firstEffect)
zaudio.stop(secondEffect)
zaudio.unloadAll()
zaudio.shutdown()
} stop
