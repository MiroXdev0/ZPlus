use zphysics
use zgraphics

start:
    let window = zgraphics.createWindow("ZPhysics visualization", 640, 480)
    zgraphics.background(window, "#101820")
    zgraphics.setTargetFPS(window, 60)
    zgraphics.show(window)

    let world = zphysics.createWorld(0, 900)
    let floor = zphysics.createBody(world, "static", 320, 420)
    zphysics.createBox(world, floor, 600, 20)
    let ball = zphysics.createBody(world, "dynamic", 180, 80)
    zphysics.createCircle(world, ball, 22)
    let block = zphysics.createBody(world, "dynamic", 360, 40)
    zphysics.createBox(world, block, 42, 42)

    while zgraphics.isOpen(window):
        zgraphics.update(window)
        if zgraphics.keyDown(window, 27):
            zgraphics.close(window)
        else:
        end
        if zgraphics.isOpen(window):
            let delta = zgraphics.deltaTimeMs(window) / 1000
            zphysics.update(world, delta)
            zgraphics.clear(window)
            zgraphics.rectangle(window, 20, 410, 600, 20, "#738290", true, 1)
            let ballX = zphysics.getPositionX(ball)
            let ballY = zphysics.getPositionY(ball)
            let blockX = zphysics.getPositionX(block)
            let blockY = zphysics.getPositionY(block)
            let count = zphysics.bodyCount(world)
            let countText = zgraphics.numberText(count)
            let status = "Bodies: " + countText
            zgraphics.circle(window, ballX, ballY, 22, "#4CC9F0", false, 2)
            zgraphics.rectangle(window, blockX - 21, blockY - 21, 42, 42, "#F4A261", false, 2)
            zgraphics.text(window, status, 16, 16, "#FFFFFF", 16)
        else:
        end
    end

    zphysics.destroyWorld(world)
    zgraphics.close(window)
stop
