use zphysics

start {

    let world = zphysics.createWorld(0, 980)
    let floor = zphysics.createBody(world, "static", 320, 420)
    zphysics.createBox(world, floor, 600, 20)
    let first = zphysics.createBody(world, "dynamic", 180, 40)
    zphysics.createCircle(world, first, 18)
    let second = zphysics.createBody(world, "dynamic", 320, 20)
    zphysics.createBox(world, second, 36, 36)
    let third = zphysics.createBody(world, "dynamic", 460, 40)
    zphysics.createCircle(world, third, 24)

    for (let frame: number = 0; frame < 300; frame++) {
        zphysics.update(world, 1 / 60)
    } end for

    say("Final center Y values:")
    say(zphysics.getPositionY(first))
    say(zphysics.getPositionY(second))
    say(zphysics.getPositionY(third))
    say("Floor contacts:")
    say(zphysics.contactCount(world))
    zphysics.destroyWorld(world)
} stop
