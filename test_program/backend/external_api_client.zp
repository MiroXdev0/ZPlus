use zhttp as http
use zjson as json
use zgraphics as graphics

start {
    let response = http.request("GET", "http://127.0.0.1:8080/health", "{}", "", 5000)
    let status = json.getNumber(response, "/status")
    if status == 200 {
        printz("Health service replied: ", json.getString(response, "/body"), "\n")
    } else {
        printz("Health request failed with status ", graphics.numberText(status), "\n")
    } end if
} stop
