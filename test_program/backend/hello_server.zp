use zhttp as http
use zjson as json

start:
    let server = http.serverCreate("127.0.0.1", 8080)
    http.serverConfigure(server, 1048576, 30000)
    let serving = false
    if http.serverStart(server):
        serving = true
        printz("Hello Server listening on http://127.0.0.1:8080\n")
    else:
        printz("Could not start HTTP server\n")
    end

    while serving:
        let request = http.serverNext(server, 250)
        if request != "":
            let method = json.getString(request, "/method")
            let path = json.getString(request, "/path")
            let requestId = json.getNumber(request, "/id")
            if method == "GET" and path == "/health":
                http.serverRespond(server, requestId, 200, "{\"content-type\":\"text/plain; charset=utf-8\"}", "ok\n")
            else:
                if method == "POST" and path == "/__stop":
                    http.serverRespond(server, requestId, 200, "{\"content-type\":\"text/plain\"}", "stopping\n")
                    serving = false
                else:
                    http.serverRespond(server, requestId, 404, "{\"content-type\":\"text/plain\"}", "not found\n")
                end
            end
        else:
            printz("")
        end
    end

    http.serverStop(server)
stop
