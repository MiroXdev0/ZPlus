function(copy_directory_if_different source_dir destination_dir)
    if(NOT IS_DIRECTORY "${source_dir}")
        message(FATAL_ERROR "Resource directory is missing: ${source_dir}")
    endif()

    file(MAKE_DIRECTORY "${destination_dir}")
    file(GLOB_RECURSE source_files LIST_DIRECTORIES false "${source_dir}/*")
    set(expected_files)
    foreach(source_file IN LISTS source_files)
        file(RELATIVE_PATH relative_path "${source_dir}" "${source_file}")
        list(APPEND expected_files "${relative_path}")

        set(destination_file "${destination_dir}/${relative_path}")
        get_filename_component(destination_parent "${destination_file}" DIRECTORY)
        file(MAKE_DIRECTORY "${destination_parent}")
        configure_file("${source_file}" "${destination_file}" COPYONLY)
    endforeach()

    file(GLOB_RECURSE destination_files LIST_DIRECTORIES false "${destination_dir}/*")
    foreach(destination_file IN LISTS destination_files)
        file(RELATIVE_PATH relative_path "${destination_dir}" "${destination_file}")
        if(NOT relative_path IN_LIST expected_files)
            file(REMOVE "${destination_file}")
        endif()
    endforeach()

    file(GLOB_RECURSE destination_directories LIST_DIRECTORIES true "${destination_dir}/*")
    list(SORT destination_directories ORDER DESCENDING)
    foreach(destination_directory IN LISTS destination_directories)
        if(IS_DIRECTORY "${destination_directory}")
            file(GLOB directory_entries "${destination_directory}/*")
            if(NOT directory_entries)
                file(REMOVE_RECURSE "${destination_directory}")
            endif()
        endif()
    endforeach()
endfunction()

if(DEFINED SOURCE_DIR AND DEFINED DESTINATION_DIR)
    copy_directory_if_different("${SOURCE_DIR}" "${DESTINATION_DIR}")
endif()
