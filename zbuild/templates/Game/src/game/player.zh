use zgraphics
use "../systems/collision.zh" as collision

pub fn moveX(window: number, x: number, direction: number) -> number:
    return collision.clampX(x + direction * 5, 720)
end

pub fn moveY(window: number, y: number, direction: number) -> number:
    return collision.clampY(y + direction * 5, 420)
end

pub fn draw(window: number, x: number, y: number):
    zgraphics.rectangle(window, x, y, 28, 28, "#F87171", true, 1)
end
