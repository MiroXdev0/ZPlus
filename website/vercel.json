{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/registry.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon-dark.png"
    },
    {
      "source": "/api/registry/:path*",
      "destination": "/api/registry?route=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
