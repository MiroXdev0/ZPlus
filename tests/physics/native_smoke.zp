use zp.physics

start {

    let world = physics.createWorld(0, 0)
    physics.setGravity(world, 0.25, -0.5)
    let body = physics.createBody(world, "static", 10, 10)
    physics.createBox(world, body, 4, 4)
    let hits = physics.pointQuery(world, 10, 10)
    let rayBody = physics.raycast(world, 0, 10, 20, 10)
    if hits == 1 and rayBody == body and physics.bodyCount(world) == 1 and physics.getGravityX(world) == 0.25 and physics.getGravityY(world) == -0.5 {
        say("ZPhysics native integration passed")
    } else {
        say("ZPhysics native integration failed")
    } end if
    physics.destroyWorld(world)
} stop
