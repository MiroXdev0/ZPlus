start{
    fn commands() {
        say("command list :\n")
        say("exit - exit the OS\n")
        say("help - show this command list\n")
        say("clear - clear the screen\n")
        say("echo - echo a message")
    } end fn

    say("This is a OS\n")
    say("not a short script writen which Z+")
    commands()
    say("type a command :")
    let command = read()   

    if command == "exit" {
        say("exiting...")
        // its not going to exit...
    } else if command == "help" {
        commands()
    } else if command == "clear" {
        // forgot how to clear the screen in Z+
    } else if command == "echo" {
        say("echo: " + read())
    } else {
        say("command not found")
    } end if
} stop