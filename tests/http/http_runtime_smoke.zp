use zhttp as http

start {

    let server = http.serverCreate("127.0.0.1", 0)
    if http.serverStart(server) {
        printz("http-started\n")
    } else {
        printz("http-start-failed\n")
    } end if
    if http.serverPort(server) > 0 {
        printz("http-port-assigned\n")
    } else {
        printz("http-port-missing\n")
    } end if
    if http.serverRunning(server) {
        printz("http-running\n")
    } else {
        printz("http-not-running\n")
    } end if
    http.serverNext(server, 1)
    printz("http-poll-completed\n")
    http.serverStop(server)
    printz("http-stopped\n")
} stop
