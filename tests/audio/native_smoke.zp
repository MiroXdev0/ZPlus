use zp.audio

start {

if audio.deviceCount() > 0 {
    audio.initialize()
    let music = audio.loadMusic("tone.mp3")
    let effect = audio.loadSound("tone.wav")
    audio.setVolume(music, 0.7)
    audio.setLooping(music, true)
    audio.setPlaybackPosition(music, 0.1)
    audio.play(music)
    audio.pause(music)
    audio.resume(music)
    audio.play(effect)
    audio.play(effect)
    audio.stop(effect)
    audio.stop(music)
    audio.unloadAll()
    audio.shutdown()
    say("Audio native integration passed")
} else {
    say("Audio native integration skipped: no playback device")
} end if
} stop
