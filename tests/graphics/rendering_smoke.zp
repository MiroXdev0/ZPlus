use zp.graphics

start {

    let app = graphics.createWindow("ZGraphics rendering smoke", 480, 300)
    let x: number = 24
    let direction: number = 1
    let frame: number = 0

    graphics.setTargetFPS(app, 60)
    graphics.background(app, "#102030")
    graphics.show(app)

    while graphics.isOpen(app) and frame < 120 {
        graphics.update(app)
        if graphics.keyDown(app, 27) {
            graphics.close(app)
        } else {
            graphics.clear(app)
            graphics.background(app, "#102030")
            graphics.rectangle(app, x, 96, 52, 52, "#22C55E", true, 1)
            graphics.text(app, "Buffered frame " + graphics.numberText(frame), 24, 28, "#F8FAFC", 20)
            x += direction * 5
            if x >= 404 {
                direction = -1
            } else {
                if x <= 24 {
                    direction = 1
                } else {
                } end if
            } end if
            frame += 1
        } end if
    } end while

    if graphics.isOpen(app) {
        graphics.close(app)
    } else {
    } end if
    say("ZGraphics buffered rendering smoke passed")
} stop
