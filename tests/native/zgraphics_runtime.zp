use zp.graphics

start {

    let app = graphics.createWindow("Z+ native graphics test", 320, 240)
    graphics.setTitle(app, "Z+ native graphics test passed")
    graphics.setPosition(app, 24, 36)
    graphics.resize(app, 320, 240)
    graphics.background(app, "#152030")
    graphics.clear(app)
    graphics.text(app, graphics.numberText(42), 8, 8, "#FFFFFF", 18)
    graphics.line(app, 0, 0, 30, 30, "#00FF00", 2)
    graphics.rectangle(app, 40, 40, 30, 20, "#FF0000", true, 1)
    graphics.circle(app, 100, 100, 15, "#0000FF", false, 2)
    graphics.setTargetFPS(app, 0)
    graphics.update(app)
    if not graphics.isOpen(app) or graphics.deltaTimeMs(app) < 0 {
        say("native graphics frame/input API failed")
    } else {
    } end if
    if not graphics.pointInRectangle(10, 10, 0, 0, 20, 20) {
        say("native graphics rectangle helper failed")
    } else {
    } end if
    if not graphics.rectanglesIntersect(0, 0, 20, 20, 10, 10, 20, 20) {
        say("native graphics intersection helper failed")
    } else {
    } end if
    if not graphics.pointInCircle(5, 5, 5, 5, 2) {
        say("native graphics circle helper failed")
    } else {
    } end if
    if not graphics.circlesIntersect(5, 5, 5, 10, 5, 5) {
        say("native graphics circle intersection helper failed")
    } else {
    } end if
    let event = graphics.pollEvent(app)
    let eventX = graphics.eventX(app)
    let eventY = graphics.eventY(app)
    let eventKey = graphics.eventKey(app)
    let eventText = graphics.eventText(app)
    graphics.hide(app)
    graphics.show(app)
    graphics.minimize(app)
    graphics.maximize(app)
    graphics.close(app)
    let status = graphics.run(app)
    if status == 0 {
        say("native ZGraphics passed")
    } else {
        say("native ZGraphics failed")
    } end if
} stop
