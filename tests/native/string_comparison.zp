use zjson as json

start {
    let method = "POST"
    if method == "POST" {
        printz("string equality passed\n")
    } else {
        printz("string equality failed\n")
    } end if
    if "same" != "different" {
        printz("string inequality passed\n")
    } else {
        printz("string inequality failed\n")
    } end if
    let dynamic = json.getString("{\"path\":\"/__stop\"}", "/path")
    if dynamic == "/__stop" {
        printz("dynamic string equality passed\n")
    } end if
    if dynamic != "/users" {
        printz("dynamic string inequality passed\n")
    } end if
    if dynamic == "/__stop" and dynamic == "/users" {
        printz("dynamic conjunction failed\n")
    } else {
        printz("dynamic conjunction passed\n")
    } end if
} stop
