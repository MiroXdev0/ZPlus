start {
fn sideEffect(): boolean {
    say("unexpected side effect")
    return true
} end fn

    if false and sideEffect() {
        say("and failed")
    } else {
        say("and short-circuited")
    } end if

    if true or sideEffect() {
        say("or short-circuited")
    } else {
        say("or failed")
    } end if

    if false && sideEffect() {
        say("and symbol failed")
    } else {
        say("and symbol short-circuited")
    } end if

    if true || sideEffect() {
        say("or symbol short-circuited")
    } else {
        say("or symbol failed")
    } end if

    if true and sideEffect() {
        say("and evaluated right operand")
    } else {
        say("and skipped required operand")
    } end if

    if false or sideEffect() {
        say("or evaluated right operand")
    } else {
        say("or skipped required operand")
    } end if
} stop
