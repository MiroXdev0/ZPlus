fn total(base: number, increment: number = base + 2, multiplier: number = increment * 2): number {
    return base + increment + multiplier
} end fn

fn callLater(): number {
    return later(4)
} end fn

fn later(base: number, offset: number = base + 3): number {
    return base + offset
} end fn

start {
    if total(3) == 18 {
        say("default arguments passed")
    } else {
        say("default arguments failed")
    } end if

    if total(3, 5) == 18 {
        say("partial defaults passed")
    } else {
        say("partial defaults failed")
    } end if

    if total(3, 5, 7) == 15 {
        say("explicit arguments passed")
    } else {
        say("explicit arguments failed")
    } end if

    if callLater() == 11 {
        say("forward default call passed")
    } else {
        say("forward default call failed")
    } end if
} stop
