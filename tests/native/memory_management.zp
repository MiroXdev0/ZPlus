use zp.memory.management

start {

let shared: string = "global" + " string"

fn decorate(value: string): string {
    return value + "!"
} end fn

fn makeTransient(value: string): string {
    return decorate(value) + "?"
} end fn

fn readShared(): string {
    return shared
} end fn

fn exerciseActiveRoot(value: string): string {
    memory.setThreshold(1024)
    let result: string = value + "!"
    for (let i: number = 0; i < 5000; i++) {
        let churn: string = "a" + "b"
    } end for
    return result
} end fn

    let transient: string = makeTransient("managed")
    if memory.heapObjects() > 0 {
        say("native managed string allocated")
    } else {
        say("native managed string missing")
    } end if
    say(transient)
    transient = "released"
    memory.collect()
    say(readShared())
    if memory.heapObjects() == 1 {
        say("native managed string reclaimed")
    } else {
        say("native managed string retained")
    } end if
    say(exerciseActiveRoot(readShared()))
    if memory.collectionCount() > 0 {
        say("native collection completed")
    } else {
        say("native collection missing")
    } end if
} stop
