fn shadowParameter(value: number): number {
    if true {
        let value: number = 9
        if value == 9 {
            say("parameter inner")
        } else {
            say("parameter inner failed")
        } end if
    } else {
        say("parameter branch failed")
    } end if
    return value
} end fn

fn nestedShadow(): number {
    let value: number = 10
    if true {
        let value: number = 20
        if true {
            let value: number = 30
            if value == 30 {
                say("nested inner")
            } else {
                say("nested inner failed")
            } end if
        } else {
            say("nested branch failed")
        } end if
        if value == 20 {
            say("nested scope retained")
        } else {
            say("nested scope failed")
        } end if
        value = 40
        if value == 40 {
            say("inner assignment")
        } else {
            say("inner assignment failed")
        } end if
    } else {
        say("outer branch failed")
    } end if
    if value == 10 {
        say("outer retained")
    } else {
        say("outer overwritten")
    } end if
    return value
} end fn

start {
    let result: number = nestedShadow()
    if result == 10 {
        say("function outer retained")
    } else {
        say("function outer overwritten")
    } end if

    let parameterResult: number = shadowParameter(7)
    if parameterResult == 7 {
        say("parameter retained")
    } else {
        say("parameter overwritten")
    } end if

    let outer: number = 1
    if true {
        outer = 2
        if outer == 2 {
            say("outer assignment")
        } else {
            say("outer assignment failed")
        } end if
    } else {
        say("assignment branch failed")
    } end if

    let branchValue: number = 100
    if true {
        let branchValue: number = 5
        if branchValue == 5 {
            say("then binding")
        } else {
            say("then binding failed")
        } end if
    } else {
        let branchValue: number = 6
        if branchValue == 6 {
            say("else binding")
        } else {
            say("else binding failed")
        } end if
    } end if
    if false {
        let branchValue: number = 7
        say("false branch binding failed")
    } else {
        let branchValue: number = 8
        if branchValue == 8 {
            say("separate else binding")
        } else {
            say("separate else binding failed")
        } end if
    } end if
    if branchValue == 100 {
        say("branch outer retained")
    } else {
        say("branch outer overwritten")
    } end if

    let loopValue: number = 100
    for (let i: number = 0; i < 2; i++) {
        let loopValue: number = i + 1
        if loopValue == i + 1 {
            say("loop binding")
        } else {
            say("loop binding failed")
        } end if
        if i == 0 {
            let i: number = 8
            if i == 8 {
                say("loop shadow")
            } else {
                say("loop shadow failed")
            } end if
        } else {
            if i == 1 {
                say("loop variable retained")
            } else {
                say("loop variable overwritten")
            } end if
        } end if
    } end for
    if loopValue == 100 {
        say("loop outer retained")
    } else {
        say("loop outer overwritten")
    } end if
} stop
