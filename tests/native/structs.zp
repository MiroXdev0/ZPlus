use zmemory.management

start {

struct Player {
    name: string
    score: number = 4
} end struct

struct Session {
    player: Player
    players: Player[]
} end struct

fn preserve(player: Player): Player {
    return player
} end fn

    let player = Player("native")
    let alias = preserve(player)
    if player is Player {
        say("struct type check passed")
    } end if
    if player == alias {
        say("struct reference identity passed")
    } end if
    alias.score = 11
    say(player.score)

    let other = Player("other")
    let session = Session(player, [alias, other])
    say(session.player.name)
    session.players[1].score = 19
    say(session.players[1].score)

    zmemory.setThreshold(1024)
    for (let i: number = 0; i < 2000; i++) {
        let transient = Player("temporary")
    } end for
    say(session.player.name)
    say(session.players[1].score)
    if zmemory.collectionCount() > 0 {
        say("struct references survived collection")
    } end if
} stop
