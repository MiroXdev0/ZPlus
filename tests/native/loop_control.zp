start {
    let total: number = 0
    for (let index: number = 0; index < 6; index++) {
        if index == 2 {
            continue
        } else {
        } end if
        if index == 5 {
            break
        } else {
        } end if
        total += index
    } end for

    repeat(3) {
        total += 10
    } end repeat

    if total == 38 {
        say("loop control passed")
    } else {
        say("loop control failed")
    } end if
} stop
