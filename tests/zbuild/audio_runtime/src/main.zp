use zp.audio

start {

if audio.deviceCount() > 0 {
    audio.initialize()
    let music = audio.loadMusic("assets/tone.ogg")
    audio.play(music)
    audio.stop(music)
    audio.unload(music)
    audio.shutdown()
    say("ZBuild audio integration passed")
} else {
    say("ZBuild audio integration skipped: no playback device")
} end if
} stop
