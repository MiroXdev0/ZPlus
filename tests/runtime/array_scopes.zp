let values: number[] = [1, 2]

start {
    if true {
        let values: number[] = [3]
        values[0] = 4
        let nested: number[][] = [[5]]
        nested[0][0] = 6
        say(values[0])
        say(nested[0][0])
        values = [7]
        say(values[0])
    } else {
        say(0)
    } end if

    values[0] = 9
    say(values[0])
    say(length(values))

    for (let iteration: number = 0; iteration < 2; iteration++) {
        let current: number[] = [iteration]
        current[0] += 1
        say(current[0])
    } end for
    say(values[0])
} stop
