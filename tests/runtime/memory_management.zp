use zp.memory.management
use "modules/memory_values.zh" as values

start {

fn collectWhileActive(items: number[][]): number {
    memory.collect()
    return items[1][0]
} end fn

fn allocateRepeatedly(count: number): number {
    let result: number = 0
    for (let i: number = 0; i < count; i++) {
        let temporary: number[] = [i, i + 1]
        result += temporary[0]
    } end for
    return result
} end fn

    let baseline: number = memory.heapObjects()
    let empty: number[] = []
    let nested: number[][] = [[10, 20], [30, 40]]
    let label: string = "Z+" + " memory"
    say(length(empty))
    say(nested[1][0])
    say(label)
    say(memory.heapObjects() > baseline)
    say(memory.heapUsed() > 0)
    say(collectWhileActive(nested))
    say(values.importedValues[0] + values.importedValues[1])
    say(allocateRepeatedly(30000))
    say(memory.collectionCount() > 0)
    say(memory.heapUsed() > 0)

    let doomed: number[] = [7, 8, 9]
    let beforeCollect: number = memory.heapObjects()
    doomed = []
    memory.collect()
    say(memory.heapObjects() < beforeCollect)
    say(length(nested))
} stop
