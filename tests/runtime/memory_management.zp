use zmemory.management
use "modules/memory_values.zh" as values

fn collectWhileActive(items: number[][]) -> number:
    zmemory.collect()
    return items[1][0]
end

fn allocateRepeatedly(count: number) -> number:
    let result: number = 0
    for (let i: number = 0; i < count; i++):
        let temporary: number[] = [i, i + 1]
        result += temporary[0]
    end
    return result
end

start:
    let baseline: number = zmemory.heapObjects()
    let empty: number[] = []
    let nested: number[][] = [[10, 20], [30, 40]]
    let label: string = "Z+" + " memory"
    say(length(empty))
    say(nested[1][0])
    say(label)
    say(zmemory.heapObjects() > baseline)
    say(zmemory.heapUsed() > 0)
    say(collectWhileActive(nested))
    say(values.importedValues[0] + values.importedValues[1])
    say(allocateRepeatedly(30000))
    say(zmemory.collectionCount() > 0)
    say(zmemory.heapUsed() > 0)

    let doomed: number[] = [7, 8, 9]
    let beforeCollect: number = zmemory.heapObjects()
    doomed = []
    zmemory.collect()
    say(zmemory.heapObjects() < beforeCollect)
    say(length(nested))
stop
