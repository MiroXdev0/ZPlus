use zmemory.management

struct Player {
    name: string
    score: number
} end struct

start {
    let players: Player[] = []
    for (let i: number = 0; i < 1500; i++) {
        let player = Player("kept", i)
        push(players, player)
    } end for
    zmemory.collect()
    say(players[0].name)
    say(players[1499].score)
} stop
