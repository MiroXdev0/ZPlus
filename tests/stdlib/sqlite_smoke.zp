use zp.sqlite as sqlite
use zp.json as json

start {

    let database = sqlite.open(":memory:")
    sqlite.execute(database, "CREATE TABLE things (name TEXT, count INTEGER)", "[]")
    sqlite.execute(database, "INSERT INTO things VALUES (?, ?)", "[\"widgets\",3]")
    let rows = sqlite.query(database, "SELECT name, count FROM things", "[]")
    if json.getString(rows, "/0/name") == "widgets" and json.getNumber(rows, "/0/count") == 3 {
        printz("sqlite-query-passed\n")
    } else {
        printz("sqlite-query-failed\n")
    } end if
    sqlite.begin(database)
    sqlite.execute(database, "INSERT INTO things VALUES (?, ?)", "[\"temporary\",1]")
    sqlite.rollback(database)
    if sqlite.query(database, "SELECT name FROM things WHERE name = ?", "[\"temporary\"]") == "[]" {
        printz("sqlite-rollback-passed\n")
    } else {
        printz("sqlite-rollback-failed\n")
    } end if
    sqlite.close(database)
} stop
