use zp.json as json

start {

    let payload = "{\"user\":{\"name\":\"Mira \\uD83D\\uDE80\",\"active\":true},\"items\":[3,{\"ok\":true}]}"
    if json.valid(payload) {
        printz("json-valid\n")
    } else {
        printz("json-invalid\n")
    } end if
    printz(json.getString(payload, "/user/name"), "\n")
    printz(json.get(payload, "/items/1"), "\n")
    printz(json.getBoolean(payload, "/user/active"), "\n")
    printz(json.arrayLength(payload, "/items"), "\n")
    printz(json.arrayGet(payload, "/items", 0), "\n")
    printz(json.kind(payload, "/user"), "\n")
    printz(json.compact(" { \"n\" : 1 } "), "\n")
    printz(json.quote("a\"b"), "\n")
    if not json.valid("{bad}") {
        printz("invalid-json-rejected\n")
    } else {
        printz("invalid-json-accepted\n")
    } end if
} stop
