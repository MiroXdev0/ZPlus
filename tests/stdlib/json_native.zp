use zjson as json

start {

    let payload = "{\"number\":42,\"flag\":true,\"items\":[\"first\",\"second\"]}"
    if json.getNumber(payload, "/number") == 42 {
        printz("number-ok\n")
    } else {
        printz("number-bad\n")
    } end if
    if json.getBoolean(payload, "/flag") {
        printz("boolean-ok\n")
    } else {
        printz("boolean-bad\n")
    } end if
    printz(json.arrayGet(payload, "/items", 1), "\n")
    printz(json.kind(payload, "/items"), "\n")
    printz(json.compact(" { \"ok\" : true } "), "\n")
} stop
