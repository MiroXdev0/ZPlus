pub fn abs(value: number) -> number:
    if value < 0:
        return -value
    else:
        return value
    end
end

pub fn min(left: number, right: number) -> number:
    if left < right:
        return left
    else:
        return right
    end
end

pub fn max(left: number, right: number) -> number:
    if left > right:
        return left
    else:
        return right
    end
end

pub fn clamp(value: number, lower: number, upper: number) -> number:
    return max(lower, min(value, upper))
end
