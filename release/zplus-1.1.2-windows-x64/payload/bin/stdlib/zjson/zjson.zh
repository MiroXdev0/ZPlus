pub fn valid(source: string) -> boolean:
    return __zjson_valid(source)
end

pub fn compact(source: string) -> string:
    return __zjson_compact(source)
end

pub fn quote(value: string) -> string:
    return __zjson_quote(value)
end

pub fn get(source: string, pointer: string) -> string:
    return __zjson_get(source, pointer)
end

pub fn getString(source: string, pointer: string) -> string:
    return __zjson_getString(source, pointer)
end

pub fn getNumber(source: string, pointer: string) -> number:
    return __zjson_getNumber(source, pointer)
end

pub fn getBoolean(source: string, pointer: string) -> boolean:
    return __zjson_getBoolean(source, pointer)
end

pub fn arrayLength(source: string, pointer: string) -> number:
    return __zjson_arrayLength(source, pointer)
end

pub fn arrayGet(source: string, pointer: string, index: number) -> string:
    return __zjson_arrayGet(source, pointer, index)
end

pub fn kind(source: string, pointer: string) -> string:
    return __zjson_kind(source, pointer)
end
