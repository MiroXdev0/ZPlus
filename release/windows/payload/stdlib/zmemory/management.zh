start {
pub fn heapUsed(): number {
    return __zmemory_heapUsed()
} end fn

pub fn heapObjects(): number {
    return __zmemory_heapObjects()
} end fn

pub fn collect() {
    __zmemory_collect()
} end fn

pub fn collectionCount(): number {
    return __zmemory_collectionCount()
} end fn

pub fn setThreshold(bytes: number) {
    __zmemory_setThreshold(bytes)
} end fn
} stop
