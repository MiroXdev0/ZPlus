pub fn debug(message: string) {
    __zstdlib_log_debug(message)
} end fn
pub fn info(message: string) {
    __zstdlib_log_info(message)
} end fn
pub fn warning(message: string) {
    __zstdlib_log_warning(message)
} end fn
pub fn error(message: string) {
    __zstdlib_log_error(message)
} end fn
pub fn setLevel(level: string) {
    __zstdlib_log_setLevel(level)
} end fn
pub fn setOutput(path: string) {
    __zstdlib_log_setOutput(path)
} end fn
