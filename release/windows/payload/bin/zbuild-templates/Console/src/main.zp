use zargs as args
use zstring as text
use "commands/greeting.zh" as greeting

start {

    if args.count() > 0 {
        let name = text.trim(args.get(0))
        printz(greeting.message(name), "\n")
    } else {
        printz(greeting.message("Z+ developer"), "\n")
    } end if
    printz("Arguments received: ", args.count(), "\n")
} stop
