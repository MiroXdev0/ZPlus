{
    "name": "zplus-language",
    "displayName": "Z+ Programming Language",
    "description": "Official VS Code developer tools for the Z+ programming language and compiler.",
    "version": "1.3.5",
    "publisher": "MiroXdev0",
    "license": "Apache-2.0",
    "homepage": "https://z-plus-lang.vercel.app/",
    "repository": {
        "type": "git",
        "url": "https://github.com/MiroXdev0/ZPlus.git",
        "directory": "ZPlus_VS_code_extension"
    },
    "bugs": {
        "url": "https://github.com/MiroXdev0/ZPlus/issues"
    },
    "main": "./extension.js",
    "icon": "icons/zplus.icon.png",
    "scripts": {
        "test": "node --test",
        "check": "node --check extension.js && node --check lib/compiler.js && node --check lib/diagnostics.js && node --check lib/formatter.js && node --check lib/project-tooling.js && node --check lib/workspace-index.js && node --check test/extension.test.js"
    },

    "engines": {
        "vscode": "^1.80.0"
    },

    "categories": [
        "Programming Languages"
    ],

    "keywords": [
        "zplus",
        "z+",
        "programming language",
        "language support",
        "compiler"
    ],

    "activationEvents": [
        "onLanguage:zplus"
    ],

    "contributes": {

        "languages": [
            {
                "id": "zplus",
                "aliases": [
                    "Z+",
                    "zplus"
                ],
                "extensions": [
                    ".zp",
                    ".zh"
                ],
                "configuration": "./language-configuration.json"
            }
        ],

        "grammars": [
            {
                "language": "zplus",
                "scopeName": "source.zplus",
                "path": "./syntaxes/zplusLanguage.json"
            }
        ],

        "iconThemes": [
            {
                "id": "zplus-icon-theme",
                "label": "Z+ File Icons",
                "path": "./icons/zplus-icon-theme.json"
            }
        ],

        "snippets": [
            {
                "language": "zplus",
                "path": "./snippets/zplus.json"
            }
        ],

        "commands": [
            {
                "command": "zplus.checkFile",
                "title": "Z+: Check Current File",
                "category": "Z+"
            },
            {
                "command": "zplus.runFile",
                "title": "Z+: Run Current File",
                "category": "Z+"
            },
            {
                "command": "zplus.buildFile",
                "title": "Z+: Build Current File",
                "category": "Z+"
            },
            {
                "command": "zplus.selectCompiler",
                "title": "Z+: Select Compiler",
                "category": "Z+"
            },
            {
                "command": "zplus.showCompilerVersion",
                "title": "Z+: Show Compiler Version",
                "category": "Z+"
            },
            {
                "command": "zplus.zbuildBuildProject",
                "title": "Z+: ZBuild Build Project",
                "category": "Z+"
            },
            {
                "command": "zplus.zbuildRunProject",
                "title": "Z+: ZBuild Run Project",
                "category": "Z+"
            },
            {
                "command": "zplus.zbuildTestProject",
                "title": "Z+: ZBuild Test Project",
                "category": "Z+"
            },
            {
                "command": "zplus.zbuildInitProject",
                "title": "Z+: Create Project from Template",
                "category": "Z+"
            },
            {
                "command": "zplus.zpmInstall",
                "title": "Z+: ZPM Install Dependencies",
                "category": "Z+"
            },
            {
                "command": "zplus.zpmAdd",
                "title": "Z+: ZPM Add Local Package",
                "category": "Z+"
            },
            {
                "command": "zplus.zpmRemove",
                "title": "Z+: ZPM Remove Package",
                "category": "Z+"
            },
            {
                "command": "zplus.zpmList",
                "title": "Z+: ZPM List Packages",
                "category": "Z+"
            }
        ],

        "taskDefinitions": [
            {
                "type": "zplus",
                "required": ["command", "projectRoot"],
                "properties": {
                    "command": {
                        "type": "string",
                        "enum": ["build", "run", "test"]
                    },
                    "projectRoot": {
                        "type": "string"
                    }
                }
            }
        ],

        "configuration": {
            "title": "Z+",

            "properties": {

                "zplus.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Z+ compiler executable. Leave empty to find zp (or zp.exe) on PATH."
                },

                "zplus.zbuildPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to ZPBuild. Leave empty to find zpbuild, or the zbuild compatibility alias, on PATH."
                },

                "zplus.zpmPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to zpm. Leave empty to find zpm (or zpm.exe) on PATH."
                },

                "zplus.outputPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional output path for Z+: Build Current File. Supports ${file}, ${fileDirname}, ${fileBasename}, ${fileBasenameNoExtension}, and ${workspaceFolder}."
                },

                "zplus.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically check Z+ files when they are saved."
                },

                "zplus.checkWhileTyping": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically check Z+ files while editing."
                },

                "zplus.checkDelay": {
                    "type": "number",
                    "default": 500,
                    "minimum": 0,
                    "description": "Delay in milliseconds before checking a Z+ file after editing."
                }
            }
        }
    }
}
