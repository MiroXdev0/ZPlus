use zfile as file
use zgraphics as graphics
use zpath as path
use zprocess as process
use zsystem as system
use zstring as text
use "../components/deployment.zh" as deployment
use "../components/install-directory.zh" as location
use "../components/integration.zh" as integration
use "../components/verification.zh" as verification
use "layout.zh" as layout
use "../window.zh" as windowFactory
start {

fn isEmpty(value: string): boolean {
    return text.length(value) == 0
} end fn

fn drawWelcome(window: number, logoPath: string) {
    layout.frame(window, 0, "Welcome to Z+", "A stable, independent programming language and toolchain.", logoPath)
    graphics.rectangle(window, 298, 224, 624, 224, "#1D272F", true, 1)
    graphics.text(window, "Z+ Programming Language", 326, 258, "#EAF1F4", 24)
    graphics.text(window, "Version 1.1.2", 326, 302, "#39D2C1", 16)
    graphics.text(window, "Stable release", 326, 334, "#AFC0C7", 14)
    graphics.line(window, 326, 370, 886, 370, "#34414A", 1)
    graphics.text(window, "Build by Miroslav Aleksandrov", 326, 394, "#39D2C1", 15)
    layout.button(window, "Continue", 804, 612, 144, true)
} end fn

fn drawLicense(window: number, licensePath: string, logoPath: string) {
    layout.frame(window, 1, "License agreement", "Review the Z+ terms before continuing.", logoPath)
    graphics.rectangle(window, 298, 224, 624, 224, "#1D272F", true, 1)
    graphics.text(window, "Proprietary source code", 326, 252, "#EAF1F4", 17)
    graphics.text(window, "Z+ source code is protected; all rights are reserved.", 326, 288, "#B8C6CC", 13)
    graphics.text(window, "Compiled binaries may be used under the end-user terms.", 326, 316, "#B8C6CC", 13)
    graphics.text(window, "Third-party components remain under their own licenses.", 326, 344, "#B8C6CC", 13)
    graphics.text(window, "The complete LICENSE.txt is included in the distribution.", 326, 372, "#91A1AA", 12)
    if file.exists(licensePath) {
        layout.button(window, "Open full license", 326, 520, 200, false)
    } else {
        graphics.text(window, "The full license file is missing from the payload.", 326, 520, "#F3A5A5", 12)
    } end if
    layout.button(window, "I Agree", 804, 612, 144, true)
} end fn

fn drawLocation(window: number, destination: string, error: string, logoPath: string) {
    layout.frame(window, 2, "Choose an installation folder", "Z+ will be installed into a new or empty directory.", logoPath)
    graphics.rectangle(window, 298, 224, 624, 224, "#1D272F", true, 1)
    graphics.text(window, "Installation directory", 326, 250, "#EAF1F4", 15)
    graphics.rectangle(window, 326, 282, 428, 44, "#11171D", true, 1)
    graphics.rectangle(window, 326, 282, 428, 44, "#34414A", false, 1)
    graphics.text(window, destination, 340, 296, "#DDE7EC", 12)
    layout.button(window, "Browse...", 774, 282, 152, false)
    graphics.text(window, "Available space", 326, 348, "#91A1AA", 12)
    graphics.text(window, graphics.numberText(system.availableSpace(destination)) + " bytes", 326, 371, "#B8C6CC", 13)
    graphics.text(window, "Choose an empty directory to protect unrelated files.", 326, 414, "#91A1AA", 12)
    if not isEmpty(error) {
        graphics.text(window, error, 326, 472, "#F3A5A5", 12)
    } end if
    layout.button(window, "Next", 804, 612, 144, true)
} end fn

fn drawComponents(window: number, docs: boolean, examples: boolean, logoPath: string) {
    layout.frame(window, 3, "Select components", "Choose which optional resources to include.", logoPath)
    graphics.rectangle(window, 298, 224, 624, 256, "#1D272F", true, 1)
    graphics.text(window, "Required", 326, 248, "#39D2C1", 12)
    graphics.rectangle(window, 326, 276, 564, 48, "#222D34", true, 1)
    graphics.rectangle(window, 344, 291, 18, 18, "#20BFAE", true, 1)
    graphics.text(window, "Compiler, standard library and ZBuild", 380, 292, "#EAF1F4", 14)
    graphics.text(window, "Always installed so the toolchain works as a unit.", 380, 309, "#91A1AA", 11)

    graphics.text(window, "Optional resources", 326, 334, "#39D2C1", 12)
    drawOption(window, "Documentation", "Syntax reference and project guides.", 354, docs)
    drawOption(window, "Example projects", "Small programs demonstrating Z+ usage.", 408, examples)
    layout.button(window, "Install", 804, 612, 144, true)
} end fn

fn drawOption(window: number, title: string, description: string, y: number, checked: boolean) {
    graphics.rectangle(window, 326, y, 564, 48, "#222D34", true, 1)
    graphics.rectangle(window, 344, y + 15, 18, 18, "#11171D", true, 1)
    graphics.rectangle(window, 344, y + 15, 18, 18, "#52636C", false, 1)
    if checked {
        graphics.rectangle(window, 348, y + 19, 10, 10, "#20BFAE", true, 1)
    } end if
    graphics.text(window, title, 380, y + 7, "#EAF1F4", 14)
    graphics.text(window, description, 380, y + 26, "#91A1AA", 11)
} end fn

fn drawComplete(window: number, destination: string, error: string, logoPath: string) {
    if isEmpty(error) {
        layout.frame(window, 5, "Installation complete", "Z+ 1.1.2 Stable was installed and verified.", logoPath)
        graphics.rectangle(window, 298, 224, 624, 224, "#1D272F", true, 1)
        graphics.circle(window, 342, 276, 16, "#20BFAE", true, 1)
        graphics.text(window, "Z+", 330, 266, "#09201F", 13)
        graphics.text(window, "Your Z+ toolchain is ready.", 374, 260, "#EAF1F4", 17)
        graphics.text(window, "Installed to", 326, 316, "#91A1AA", 12)
        graphics.text(window, destination, 326, 340, "#DDE7EC", 13)
        graphics.text(window, "Build by Miroslav Aleksandrov", 326, 394, "#39D2C1", 14)
        layout.button(window, "Open documentation", 292, 520, 200, false)
        layout.button(window, "Verify again", 508, 520, 200, false)
    } else {
        layout.frame(window, 5, "Installation did not complete", "The installer could not verify a usable Z+ toolchain.", logoPath)
        graphics.rectangle(window, 298, 224, 624, 224, "#1D272F", true, 1)
        graphics.text(window, "The installation was rolled back where possible.", 326, 256, "#EAF1F4", 15)
        graphics.text(window, error, 326, 294, "#F3A5A5", 13)
        graphics.text(window, "Details are recorded in the installation log when available.", 326, 390, "#91A1AA", 12)
    } end if
} end fn

pub fn run(payloadDirectory: string, payloadManifest: string) {
    let app = windowFactory.create()
    let page = 0
    let destination = location.defaultDirectory()
    let docs = true
    let examples = true
    let licensePath = path.join(payloadDirectory, "LICENSE.txt")
    let docsPath = path.join(payloadDirectory, "docs")
    let logoPath = path.join(docsPath, "ZPlusLogo.png")
    let error = ""
    let running = true

    while running and graphics.isOpen(app) {
        if page == 0 {
            drawWelcome(app, logoPath)
        } else {
            if page == 1 {
                drawLicense(app, licensePath, logoPath)
            } else {
                if page == 2 {
                    drawLocation(app, destination, error, logoPath)
                } else {
                    if page == 3 {
                        drawComponents(app, docs, examples, logoPath)
                    } else {
                        drawComplete(app, destination, error, logoPath)
                    } end if
                } end if
            } end if
        } end if
        graphics.update(app)
        let event = graphics.pollEvent(app)
        if event == 1 {
            running = false
        } else {
            if event == 3 and graphics.eventKey(app) == 1 {
                let action = layout.actionAt(page, graphics.eventX(app), graphics.eventY(app))
                if action == 2 {
                    let answer = system.messageBox("Z+ Setup", "Cancel setup now?", "yesNo", "warning")
                    if answer == 6 {
                        running = false
                    } end if
                } else {
                    if page == 0 and action == 1 {
                        page = 1
                    } else {
                        if page == 1 {
                            if action == 4 {
                                page = 0
                            } else {
                                if action == 3 {
                                    page = 2
                                } else {
                                    if action == 5 and file.exists(licensePath) {
                                        process.run("notepad.exe", [licensePath], payloadDirectory, 15000)
                                    } end if
                                } end if
                            } end if
                        } else {
                            if page == 2 {
                                if action == 4 {
                                    page = 1
                                    error = ""
                                } else {
                                    if action == 6 {
                                        let selected = system.selectFolder("Select Z+ installation folder", destination)
                                        if not isEmpty(selected) {
                                            destination = selected
                                            error = ""
                                        } end if
                                    } else {
                                        if action == 7 {
                                            if not location.isSafe(destination) {
                                                error = "Choose a safe absolute installation directory."
                                            } else {
                                                page = 3
                                                error = ""
                                            } end if
                                        } end if
                                    } end if
                                } end if
                            } else {
                                if page == 3 {
                                    if action == 4 {
                                        page = 2
                                    } else {
                                        if action == 8 {
                                            docs = not docs
                                        } else {
                                            if action == 9 {
                                                examples = not examples
                                            } else {
                                                if action == 10 {
                                                    page = 4
                                                    error = deployment.install(payloadDirectory, payloadManifest, destination, docs, examples, app, logoPath)
                                                    if isEmpty(error) {
                                                        error = integration.configure(destination, system.executablePath())
                                                        if not isEmpty(error) {
                                                            integration.remove(destination)
                                                            deployment.uninstall(destination)
                                                        } else {
                                                            error = verification.verify(destination)
                                                            if not isEmpty(error) {
                                                                integration.remove(destination)
                                                                deployment.uninstall(destination)
                                                            } end if
                                                        } end if
                                                    } end if
                                                    page = 5
                                                } end if
                                            } end if
                                        } end if
                                    } end if
                                } else {
                                    if page == 5 {
                                        if action == 11 and isEmpty(error) {
                                            process.run("explorer.exe", [docsPath], payloadDirectory, 15000)
                                        } else {
                                            if action == 12 and isEmpty(error) {
                                                error = verification.verify(destination)
                                            } else {
                                                if action == 13 {
                                                    running = false
                                                } end if
                                            } end if
                                        } end if
                                    } end if
                                } end if
                            } end if
                        } end if
                    } end if
                } end if
            } end if
        } end if
    } end while
    graphics.close(app)
} end fn
} stop
