use zp.env as env
use zp.file as file
use zp.path as path
use zp.string as text
use "../src/components/deployment.zh" as deployment
use "../src/components/verification.zh" as verification

start {

    let payload = env.get("ZPLUS_TEST_PAYLOAD")
    let manifest = env.get("ZPLUS_TEST_MANIFEST")
    let destination = env.get("ZPLUS_TEST_INSTALL_ROOT")
    let installError = deployment.install(payload, manifest, destination, false, false, 0, "")
    if text.length(installError) != 0 {
        say("release install failed: " + installError)
    } else {
        let verificationError = verification.verify(destination)
        if text.length(verificationError) != 0 {
            deployment.uninstall(destination)
            say("release verification failed: " + verificationError)
        } else {
            let uninstallResult = deployment.uninstall(destination)
            if file.exists(path.join(destination, "bin\\zp.exe")) {
                say("release uninstaller left the compiler executable behind")
            } else {
                if not text.contains(uninstallResult, "removed") {
                    say("release uninstall did not report success")
                } else {
                    say("ZPLUS_RELEASE_INSTALL_WORKFLOW_OK")
                } end if
            } end if
        } end if
    } end if
} stop
